# Public browser configuration. These values identify a Supabase project and are
# safe to expose only when Row Level Security is correctly enabled.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only configuration. Never put this value in public/, browser code,
# extension files, screenshots, documentation, or source control.
SUPABASE_SERVICE_ROLE_KEY=

# local keeps the current prototype available during migration.
# hosted requires configured Supabase identity and must be used for production.
LOTCASTER_AUTH_MODE=local
LOTCASTER_ENVIRONMENT=development
